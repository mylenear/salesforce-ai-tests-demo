# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# --- JWT Bearer Flow (MFA-free, for CI) ---
# Connected App Consumer Key from Setup → App Manager → your app → View
SF_CLIENT_ID=your-connected-app-consumer-key

# Username the JWT will authenticate as
SF_JWT_USERNAME=your-test-user@example.com

# RSA private key PEM — use literal \n for newlines so it fits on one line in .env
# Generate with: openssl genrsa -out private.key 2048
# Then: SF_PRIVATE_KEY="$(awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.key)"
SF_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# Override if using a sandbox (e.g. https://test.salesforce.com)
# SF_LOGIN_URL=https://login.salesforce.com

# Lightning base URL of the org the browser tests run against (used as
# {{env.dev.login_url}}). Must be the same org SF_JWT_USERNAME belongs to.
# Defaults to the value in config/env.yaml when unset.
# SF_LIGHTNING_URL=https://your-domain.lightning.force.com
